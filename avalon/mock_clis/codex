#!/usr/bin/env python3
"""Stand-in for `codex app-server --stdio` in arena dry runs: the JSON-RPC calls the arena uses, mock moves."""
import json
import sys
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from avalon.arena_mock import mock_reply  # noqa: E402


def send(msg):
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


models = {}
for line in sys.stdin:
    msg = json.loads(line)
    method, i, p = msg.get("method"), msg.get("id"), msg.get("params", {})
    if i is None:
        continue
    if method == "initialize":
        send({"id": i, "result": {"userAgent": "mock-codex"}})
    elif method == "model/list":
        send({"id": i, "result": {"data": [{"model": "gpt-6-luna"}, {"model": "mock"}]}})
    elif method == "thread/start":
        tid = str(uuid.uuid4())
        models[tid] = p["model"]
        send({"id": i, "result": {"thread": {"id": tid}, "model": p["model"]}})
    elif method == "turn/start":
        turn = str(uuid.uuid4())
        send({"id": i, "result": {"turn": {"id": turn}}})
        text = mock_reply(p["input"][0]["text"])
        send({"method": "item/completed", "params": {"item": {"type": "reasoning", "summary": ["Mock reasoning."]}}})
        send({"method": "item/completed", "params": {"item": {"type": "agentMessage", "text": text}}})
        send({"method": "thread/tokenUsage/updated", "params": {"tokenUsage": {"last": {"inputTokens": 100, "outputTokens": 50}}}})
        send({"method": "turn/completed", "params": {"turn": {"id": turn, "status": "completed"}}})
    else:
        send({"id": i, "error": {"code": -32601, "message": f"mock codex: {method} unsupported"}})
