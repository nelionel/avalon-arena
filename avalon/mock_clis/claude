#!/usr/bin/env python3
"""Stand-in for `claude -p --output-format json` in arena dry runs: one mock move per call."""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from avalon.arena_mock import mock_reply  # noqa: E402

args = sys.argv[1:]
session = args[args.index("--resume") + 1] if "--resume" in args else args[args.index("--session-id") + 1]
print(json.dumps({"type": "result", "is_error": False, "result": mock_reply(sys.stdin.read()), "session_id": session,
                  "usage": {"input_tokens": 100, "output_tokens": 50}}))
